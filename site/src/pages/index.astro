---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryLabels, estimateRead, formatDate, postSlug, sortPosts } from '../lib/posts';
const posts=sortPosts(await getCollection('posts'));
const latest=posts.slice(0,3);
---
<BaseLayout active="home" bodyClass="home-v2">
<main>
  <section class="v2-hero"><div class="hero-status"><span></span>ONLINE / 正在学习、构建，也持续记录</div><div class="hero-layout"><div class="hero-main v2-reveal"><p class="v2-kicker">RAIN / SOFTWARE ENGINEERING STUDENT</p><h1><span>把想法</span><br /><em>做成作品。</em></h1><p class="hero-summary">这里记录代码、项目实践和学习过程。比起展示一个完美答案，我更愿意留下问题如何被拆开、尝试和完成。</p><div class="hero-cta"><a class="v2-button is-primary" href="/articles/">阅读文章 <span>↗</span></a><a class="v2-button" href="/projects/">查看项目 <span>↗</span></a></div></div><aside class="profile-panel art-profile v2-reveal" data-art-stage><div class="art-poster" aria-hidden="true"><span class="poster-index">R / 001</span><span class="poster-year">2026</span><div class="rain-field"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span class="poster-disc"></span><span class="poster-cross">+</span><strong>RA<br />IN</strong><img src="https://github.com/rain-lei.png?size=240" alt="" /><span class="poster-caption">MAKE · NOTE · REPEAT</span></div><div class="profile-content"><div class="profile-head"><div><span>PROFILE / 001</span><strong>rain</strong><small>student developer</small></div><b>大连 / CN</b></div><p>关注软件工程、开源实践，以及把复杂问题整理成清晰文档的方法。</p><dl class="profile-stats"><div><dt>{String(posts.length).padStart(2,'0')}</dt><dd>公开文章</dd></div><div><dt data-repo-count>08</dt><dd>公开仓库</dd></div><div><dt>2025</dt><dd>开始于</dd></div></dl>{posts[0]&&<a class="profile-latest" href={`/articles/${postSlug(posts[0])}/`}><span>最新记录</span><strong>{posts[0].data.title}</strong><b>↗</b></a>}</div></aside></div><div class="v2-ticker" aria-hidden="true"><span>SOFTWARE ENGINEERING</span><i>✦</i><span>OPEN SOURCE</span><i>✦</i><span>DOCUMENTATION</span><i>✦</i><span>CONTINUOUS LEARNING</span></div></section>
  <section class="studio-strip v2-reveal"><span class="studio-label">RAIN STUDIO<br />FIELD NOTES</span><p>不是作品集的终点，<br />是一间<strong>持续发生</strong>的工作室。</p><div class="studio-coordinates"><span>39.00° N</span><span>121.61° E</span><b>↘</b></div></section>
  <section class="v2-section latest-section"><div class="v2-section-head v2-reveal"><div><span class="section-no">01</span><p class="v2-kicker">LATEST WRITING</p><h2>最近写下的内容</h2></div><a class="v2-text-link" href="/articles/">进入文章归档 <span>↗</span></a></div><div class="home-post-list">{latest.map((post,index)=><a class="home-post v2-reveal" href={`/articles/${postSlug(post)}/`}><span class="home-post-no">{String(index+1).padStart(2,'0')}</span><span class="home-post-meta"><b>{categoryLabels[post.data.category]}</b><time>{formatDate(post.data.date)}</time><small>{estimateRead(post.body||'')}</small></span><span class="home-post-copy"><strong>{post.data.title}</strong><small>{post.data.excerpt}</small></span><span class="home-post-arrow">↗</span></a>)}</div></section>
  <section class="v2-section project-section"><div class="v2-section-head v2-reveal"><div><span class="section-no">02</span><p class="v2-kicker">RECENT PROJECTS</p><h2>最近在做什么</h2></div><a class="v2-text-link" href="/projects/">进入项目页 <span>↗</span></a></div><div class="project-preview-list v2-reveal"><div class="project-preview-status"><span>GITHUB / LIVE FEED</span><small data-repo-status aria-live="polite">正在连接 GitHub</small></div><div class="github-repo-list" data-github-repos data-repo-limit="3" aria-live="polite"><div class="repo-skeleton"><i></i><span></span><span></span></div></div><a class="project-all" href="/projects/">查看全部项目 <span>↗</span></a></div></section>
  <section class="v2-section network-section" id="contact"><div class="contact-block v2-reveal"><span class="section-no">03</span><p class="v2-kicker">CONTACT</p><h2>想交流一个问题？</h2><p>项目、开源、技术学习，或者一个还没有答案的想法，都可以写信给我。</p><a class="contact-mail" href="mailto:rain__lei@outlook.com">rain__lei@outlook.com <span>↗</span></a></div><div class="links-block v2-reveal"><div class="links-title"><div><p class="v2-kicker">FRIEND LINKS</p><h3>友链</h3></div><span>PR WELCOME</span></div><div class="friend-links-grid" id="friendLinksGrid"><a class="friend-link-card" href="https://github.com/rain-lei"><img src="https://github.com/rain-lei.png?size=96" alt="rain-lei" /><span><strong>rain-lei · GitHub</strong><small>代码、项目与最近的仓库</small></span><b>↗</b></a></div></div></section>
</main>
</BaseLayout>
