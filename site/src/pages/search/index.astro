---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { categoryLabels, formatDate, postSlug, sortPosts } from '../../lib/posts';
const posts=sortPosts(await getCollection('posts'));
const recent=posts.slice(0,4);
const topics=['大学英语','奖励评审','书院课程','Playwright','Git','C 程序设计'];
---
<BaseLayout title="全文搜索 · rain" description="搜索 rain 的全部公开文章。" active="search">
<main id="main-content" class="search-main" data-pagefind-ignore>
  <header>
    <div class="search-hero-copy">
      <h1>搜索文章</h1>
      <div class="search-console" role="search">
        <Icon name="search" class="search-console-mark" />
        <input id="pagefindInput" type="search" aria-label="搜索文章" placeholder="搜索标题、正文或标签" autocomplete="off" />
        <kbd aria-hidden="true">/</kbd>
        <button id="searchClear" type="button" aria-label="清空搜索" hidden>×</button>
      </div>
      <div class="search-topics" aria-label="常用搜索词"><span>常用</span>{topics.map(topic=><button type="button" data-search-topic={topic}>{topic}</button>)}</div>
    </div>
  </header>

  <section class="search-workspace" aria-labelledby="searchStatus">
    <div class="search-status-line">
      <h2 id="searchStatus" aria-live="polite">最近发布</h2>
      <small id="searchCount">共 {posts.length} 篇文章</small>
    </div>
    <div class="search-idle" id="searchIdle">
      <div class="search-recent-grid">{recent.map(post=><a href={`/articles/${postSlug(post)}/`}><small>{categoryLabels[post.data.category]} · {formatDate(post.data.date)}</small><strong>{post.data.title}</strong><b>↗</b></a>)}</div>
    </div>
    <div class="search-results" id="pagefindResults" hidden></div>
    <template id="searchResultTemplate">
      <article class="search-result-card">
        <a class="search-result-main">
          <div class="search-result-content"><small></small><h3></h3><p></p></div>
          <Icon name="arrow" />
        </a>
        <ul class="search-sections" aria-label="匹配章节" hidden></ul>
      </article>
    </template>
  </section>
</main>
<script src="../../scripts/search.ts"></script>
</BaseLayout>
