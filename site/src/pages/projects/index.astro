---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Loopy from '../../components/Loopy.astro';
import Icon from '../../components/Icon.astro';
import WordleTiles from '../../components/WordleTiles.astro';
---
<BaseLayout title="项目 · rain" description="rain 的课程作业、个人项目与 GitHub 仓库。" active="projects" bodyClass="projects-v2">
  <main id="main-content" class="page-main">
    <header class="page-heading"><div><p class="v2-kicker">代码与小游戏</p><h1>项目</h1></div><Loopy variant="programmer" small /></header>
    <section class="featured-project"><div><p class="v2-kicker">在线试玩</p><h2>OurEDA Winter Wordle</h2><p>六次机会，猜一个五字母单词。</p><div class="hero-cta"><a class="v2-button is-primary" href="/articles/oureda-winter-wordle/">开始游戏<Icon /></a><a class="text-link" href="https://github.com/rain-lei/oureda-25-web-winter/tree/website" target="_blank" rel="noopener noreferrer">源码<Icon name="external" /></a></div></div><a class="wordle-link project-wordle" href="/articles/oureda-winter-wordle/" aria-label="打开 Wordle 游戏"><WordleTiles /></a></section>
    <section class="project-directory"><div class="section-heading"><h2>GitHub 仓库</h2><a class="text-link" href="https://github.com/rain-lei?tab=repositories" target="_blank" rel="noopener noreferrer">在 GitHub 查看<Icon name="external" /></a></div><div class="project-directory-list"><div class="github-repo-list" data-github-repos data-repo-limit="30"><div class="repo-skeleton">正在读取仓库…</div></div></div><p class="repo-status" data-repo-status role="status">正在读取</p></section>
  </main>
</BaseLayout>
