---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import RepositoryList from '../../components/RepositoryList.astro';
import { featuredRepositories } from '../../lib/repositories';
import Icon from '../../components/Icon.astro';
import WordleTiles from '../../components/WordleTiles.astro';
---
<BaseLayout title="项目 · rain" description="rain 的课程作业、个人项目与 GitHub 仓库。" active="projects" bodyClass="projects-v2">
  <main id="main-content" class="page-main">
    <PageHeading title="项目" kicker="代码与小游戏" description="课程作业、个人项目与一些小实验。" variant="programmer" />
    <div class="project-layout">
      <section class="project-showcase" aria-labelledby="projectShowcaseHeading">
        <div class="section-heading"><h2 id="projectShowcaseHeading">作品</h2></div>
        <section class="featured-project" aria-labelledby="wordleHeading"><div><p class="v2-kicker">在线试玩</p><h3 id="wordleHeading">OurEDA Winter Wordle</h3><p>六次机会，猜一个五字母单词。</p><div class="hero-cta"><a class="v2-button is-primary" href="/articles/oureda-winter-wordle/">开始游戏<Icon /></a><a class="text-link" href="https://github.com/rain-lei/oureda-25-web-winter/tree/website" target="_blank" rel="noopener noreferrer">源码<Icon name="external" /></a></div></div><a class="wordle-link project-wordle" href="/articles/oureda-winter-wordle/" aria-label="打开 Wordle 游戏"><WordleTiles /></a></section>
        <div class="project-highlights"><RepositoryList featured={featuredRepositories} limit={2} /></div>
      </section>
      <aside class="project-directory surface-panel" aria-labelledby="repositoryHeading"><h2 id="repositoryHeading">更多仓库</h2><RepositoryList exclude={featuredRepositories} compact /><a class="text-link project-all-link" href="https://github.com/rain-lei?tab=repositories" target="_blank" rel="noopener noreferrer">在 GitHub 查看全部<Icon name="external" /></a></aside>
    </div>
  </main>
</BaseLayout>
