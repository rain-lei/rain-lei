---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabels, estimateRead, formatDate, postSlug, sortPosts } from '../../lib/posts';

const posts = sortPosts(await getCollection('posts'));
const tags = Array.from(new Set(posts.flatMap(post => post.data.tech))).sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout title="文章 · rain" description="rain 的文章、课程资料与项目记录。" active="articles" bodyClass="archive-v2">
  <main id="main-content" class="archive-main">
    <header class="archive-heading v2-reveal">
      <div>
        <p class="v2-kicker">文章 · {posts.length} 篇</p>
        <h1>文章</h1>
      </div>
      <p>按日期浏览，或用分类、标签和关键词筛选。</p>
    </header>

    <section class="archive-browser">
      <div class="archive-toolbar">
        <label class="archive-search"><span aria-hidden="true">⌕</span><input id="archiveSearch" type="search" placeholder="搜索标题、摘要或分类" autocomplete="off" /></label>
        <div class="archive-filters" aria-label="按文章分类筛选">
          <button type="button" class="is-active" data-filter="all" aria-pressed="true">全部</button>
          <button type="button" data-filter="study" aria-pressed="false">学习</button>
          <button type="button" data-filter="life" aria-pressed="false">生活</button>
          <button type="button" data-filter="entertainment" aria-pressed="false">娱乐</button>
        </div>
      </div>
      <div class="archive-tag-filters" aria-label="按文章标签筛选"><span>标签</span><button type="button" class="is-active" data-tag-filter="all" aria-pressed="true">全部</button>{tags.map(tag => <button type="button" data-tag-filter={tag} aria-pressed="false">{tag}</button>)}</div>
      <div class="archive-result-line"><span id="archiveResultCount" aria-live="polite">{posts.length} 篇文章</span><a href="/search/">全文搜索 ↗</a></div>
      <div class="archive-list">
        {posts.map((post, index) => <a class:list={['archive-item', { 'is-game': post.data.contentType === 'game' }]} data-category={post.data.category} data-tags={post.data.tech.join('|')} href={`/articles/${postSlug(post)}/`}>
          <span class="archive-item-no">{String(index + 1).padStart(2, '0')}</span>
          <span class="archive-item-main">
            <span class="archive-item-meta"><b>{post.data.contentType === 'game' ? '小游戏' : categoryLabels[post.data.category]}</b><time>{formatDate(post.data.date)}</time><small>{post.data.contentType === 'game' ? '在线试玩' : estimateRead(post.body || '')}</small></span>
            <strong>{post.data.title}</strong><p>{post.data.excerpt}</p>
            {post.data.tech.length > 0 && <span class="archive-item-tags" aria-label="文章标签">{post.data.tech.slice(0, 4).map(tag => <em>{tag}</em>)}</span>}
          </span>
          <span class="archive-item-arrow">{post.data.contentType === 'game' ? '▶' : '↗'}</span>
        </a>)}
      </div>
    </section>
  </main>
</BaseLayout>
