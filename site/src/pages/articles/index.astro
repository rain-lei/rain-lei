---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import ArticleArtwork from '../../components/ArticleArtwork.astro';
import { categoryLabels, estimateRead, formatDate, postIllustration, postSlug, sortPosts } from '../../lib/posts';
const posts=sortPosts(await getCollection('posts'));
const tags=Array.from(new Set(posts.flatMap(post=>post.data.tech))).sort((a,b)=>a.localeCompare(b,'zh-CN'));
---
<BaseLayout title="文章 · rain" description="rain 的文章、课程资料与项目记录。" active="articles">
  <main id="main-content" class="page-main">
    <PageHeading title="文章" kicker={`共 ${posts.length} 篇`} description="课程资料、开发笔记和项目记录。" variant="reading" />
    <div class="archive-layout">
      <section class="archive-browser" aria-label="文章列表">
        <div class="archive-toolbar"><label class="archive-search"><Icon name="search" /><input id="archiveSearch" type="search" aria-label="筛选文章" placeholder="搜索标题、摘要或标签" autocomplete="off" /><kbd>/</kbd></label></div>
        <div class="archive-result-line"><div class="archive-result-summary"><span id="archiveResultCount" aria-live="polite">{posts.length} 篇文章</span><button id="archiveClear" type="button" data-archive-reset hidden>清除筛选 ×</button></div><a href="/search/" data-full-search>全文搜索 →</a></div>
        <div class="archive-list">{posts.map(post=><a class="archive-item" data-category={post.data.category} data-tags={post.data.tech.join('|')} data-illustration={postIllustration(post)} href={`/articles/${postSlug(post)}/`}>
          <span class="archive-item-main"><span class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><b>{categoryLabels[post.data.category]}</b><small>{post.data.contentType==='game'?'在线试玩':estimateRead(post.body||'')}</small></span><strong><span class="post-title">{post.data.title}</span></strong><p>{post.data.excerpt}</p><span class="archive-item-footer"><span class="archive-item-tags">{post.data.tech.slice(0,3).map(tag=><em>{tag}</em>)}</span><ArticleArtwork illustration={postIllustration(post)} /></span></span><Icon class="archive-item-arrow" />
        </a>)}</div>
        <div id="archiveEmpty" class="archive-empty" hidden>
          <h2>当前筛选没有结果</h2>
          <div class="archive-empty-actions">
            <a class="v2-button is-primary" href="/search/" data-full-search hidden>在正文中搜索<Icon name="search" /></a>
            <button class="v2-button" type="button" data-archive-reset>清除筛选</button>
          </div>
        </div>
      </section>
      <aside class="archive-sidebar">
        <section class="filter-card"><h2>分类</h2><div class="archive-filters" aria-label="按文章分类筛选"><button class="is-active" type="button" data-filter="all" aria-pressed="true">全部<span>{posts.length}</span></button>{Object.entries(categoryLabels).map(([key,label])=><button type="button" data-filter={key} aria-pressed="false">{label}<span>{posts.filter(p=>p.data.category===key).length}</span></button>)}</div></section>
        <details class="filter-card tag-details" open><summary>标签<span id="archiveSelectedTag" hidden></span></summary><div class="archive-tag-filters" aria-label="按文章标签筛选"><button class="is-active" type="button" data-tag-filter="all" aria-pressed="true">全部</button>{tags.map(tag=><button type="button" data-tag-filter={tag} aria-pressed="false">{tag}</button>)}</div></details>
        {posts[0]&&<div class="random-read"><span>随机阅读</span><a data-random-read href={`/articles/${postSlug(posts[0])}/`}><strong>{posts[0].data.title}</strong><Icon name="external" /></a><button type="button" data-random-draw hidden>换一篇 ↻</button><div hidden data-random-sources>{posts.map(post=><a data-random-source href={`/articles/${postSlug(post)}/`}>{post.data.title}</a>)}</div></div>}
      </aside>
    </div>
  </main>
</BaseLayout>
