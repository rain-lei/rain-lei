---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryLabels, categoryWords, estimateRead, formatDate, postSlug, sortPosts } from '../../../lib/posts';
export async function getStaticPaths(){const posts=sortPosts(await getCollection('posts'));return posts.map(post=>({params:{id:postSlug(post)},props:{post,posts}}));}
const { post, posts }=Astro.props as { post:CollectionEntry<'posts'>; posts:CollectionEntry<'posts'>[] };
const { Content }=await render(post);
const others=posts.filter(item=>postSlug(item)!==postSlug(post)).slice(0,3);
---
<BaseLayout title={`${post.data.title} · rain`} description={post.data.excerpt} active="articles" bodyClass="article-page article-v2">
<main><article class="article-wrap"><div class="article-heading"><a class="back-crumb" href="/articles/">文章归档 / ARCHIVE</a><div class="article-meta"><span>{formatDate(post.data.date)}</span><span>{estimateRead(post.body||'')}</span></div><h1>{post.data.title}</h1><p class="article-deck">{post.data.excerpt}</p><div class="article-byline"><img class="avatar" src="https://github.com/rain-lei.png?size=160" alt="rain 的 GitHub 头像" /><span>rain<br /><small>student developer · remote</small></span></div></div><div class={`article-hero ${post.data.accent}`}><span class="visual-grid"></span><span class="visual-label">{categoryLabels[post.data.category]}</span><span class="visual-word">{categoryWords[post.data.category]}</span><span class="visual-shape"></span><span class="visual-index">RAIN / ARTICLE<br />{formatDate(post.data.date)}</span></div><div class="article-layout"><div class="article-share"><span>SHARE</span><button id="copyLink" aria-label="复制文章链接">↗</button></div><div class="article-body markdown-body" data-pagefind-body><Content /><div class="article-end"><span>✳</span><p>感谢你读到这里。愿你今天也有一点属于自己的留白。</p></div><div class="article-tags"><span>标签</span><a href="/articles/">{categoryLabels[post.data.category]}</a><a href="/articles/">个人随笔</a></div></div></div></article><section class="next-reads"><div class="section-heading"><div><p class="eyebrow">继续阅读 / KEEP READING</p><h2>也许你会喜欢</h2></div><a class="text-link" href="/articles/">全部文章 <span>↗</span></a></div><div class="mini-posts">{others.map((item,index)=><a class="mini-post" href={`/articles/${postSlug(item)}/`}><span class="mini-no">{String(index+1).padStart(2,'0')}</span><div><small>{categoryLabels[item.data.category]} · {formatDate(item.data.date)}</small><strong>{item.data.title}</strong></div><span>↗</span></a>)}</div></section></main>
<script>document.getElementById('copyLink')?.addEventListener('click',async(event)=>{await navigator.clipboard.writeText(location.href);(event.currentTarget as HTMLButtonElement).textContent='✓';});</script>
</BaseLayout>
