---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ViewCounter from '../../../components/ViewCounter.astro';
import { categoryLabels, estimateRead, formatDate, postSlug, sortPosts } from '../../../lib/posts';

export async function getStaticPaths(){
  const posts=sortPosts(await getCollection('posts'));
  return posts.map(post=>({params:{id:postSlug(post)},props:{post,posts}}));
}

const { post, posts }=Astro.props as { post:CollectionEntry<'posts'>; posts:CollectionEntry<'posts'>[] };
const { Content }=await render(post);
const others=posts
  .filter(item=>postSlug(item)!==postSlug(post))
  .sort((a,b)=>Number(b.data.category===post.data.category)-Number(a.data.category===post.data.category))
  .slice(0,3);
const contentLabel=post.data.contentType==='game'?'小游戏':categoryLabels[post.data.category];
---
<BaseLayout title={`${post.data.title} · rain`} description={post.data.excerpt} active="articles" bodyClass="article-page article-v2" type="article" publishedTime={post.data.date} updatedTime={post.data.updated} tags={post.data.tech}>
  <main id="main-content">
    <article class="article-wrap">
      <div class="article-heading">
        <a class="back-crumb" href="/articles/">← 文章列表</a>
        <div class="article-meta">
          <span data-pagefind-meta="date">发布 {formatDate(post.data.date)}</span>
          {post.data.updated&&<span class="article-updated">更新 {formatDate(post.data.updated)}</span>}
          <span>{post.data.contentType==='game'?'在线试玩':estimateRead(post.body||'')}</span>
          <ViewCounter scope="page" />
          <span class="article-category" data-pagefind-meta="category">{contentLabel}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="article-deck">{post.data.excerpt}</p>
        <div class="article-byline">
          <img class="avatar" src="/images/github-avatar.png" data-github-avatar alt="rain 的 GitHub 头像" width="34" height="34" />
          <span>rain<br /><small>大连理工大学 · 软件工程</small></span>
        </div>
      </div>

      {post.data.contentType==='game'&&post.data.playUrl&&
        <section class="game-stage" data-pagefind-ignore>
          <div class="game-stage-head">
            <div><p class="v2-kicker">小游戏</p><h2>在线试玩</h2></div>
            <div class="game-actions">
              <a href={post.data.playUrl} target="_blank" rel="noopener noreferrer">全屏打开 ↗</a>
              {post.data.repository&&<a href={post.data.repository} target="_blank" rel="noopener noreferrer">查看源码 ↗</a>}
            </div>
          </div>
          <div class="game-frame"><iframe src={post.data.playUrl} title={`${post.data.title} 在线试玩`} loading="lazy" sandbox="allow-scripts allow-same-origin"></iframe></div>
          <div class="game-tech">{post.data.tech.map((item:string)=><span>{item}</span>)}</div>
        </section>
      }

      <div class="article-layout">
        <aside class="article-rail" data-pagefind-ignore>
          <div class="article-share">
            <button id="shareLink" type="button" aria-label="分享文章" aria-describedby="shareLinkStatus"><span aria-hidden="true">↗</span><b>分享文章</b></button>
            <span class="sr-only" id="shareLinkStatus" role="status" aria-live="polite"></span>
          </div>
          <nav class="article-toc" id="articleToc" aria-label="本文目录" hidden><details id="articleTocDetails" open><summary>本文目录</summary><div id="articleTocLinks"></div></details></nav>
        </aside>
        <div class="article-body markdown-body" data-pagefind-body>
          <Content />
          {post.data.contentType==='game'&&<div class="article-end"><span>✳</span><p>游戏无法加载时，可以使用上方“全屏打开”。</p></div>}
          <div class="article-tags">
            <span>标签</span>
            <a href="/articles/">{contentLabel}</a>
            {post.data.tech.slice(0,2).map((item:string)=><a href={`/search/?q=${encodeURIComponent(item)}`}>{item}</a>)}
          </div>
        </div>
      </div>
    </article>

    <section class="next-reads">
      <div class="section-heading">
        <div><p class="eyebrow">其他文章</p><h2>继续阅读</h2></div>
        <a class="text-link" href="/articles/">全部文章 <span>↗</span></a>
      </div>
      <div class="mini-posts">{others.map((item,index)=><a class="mini-post" href={`/articles/${postSlug(item)}/`}><span class="mini-no">{String(index+1).padStart(2,'0')}</span><div><small>{item.data.contentType==='game'?'小游戏':categoryLabels[item.data.category]} · {formatDate(item.data.date)}</small><strong>{item.data.title}</strong></div><span>↗</span></a>)}</div>
    </section>
  </main>
  <script>
    const shareButton=document.getElementById('shareLink') as HTMLButtonElement|null;
    const shareStatus=document.getElementById('shareLinkStatus');
    const resetShare=()=>{if(!shareButton)return;shareButton.innerHTML='<span aria-hidden="true">↗</span><b>分享文章</b>';shareButton.setAttribute('aria-label','分享文章');};
    const copied=()=>{if(!shareButton)return;shareButton.innerHTML='<span aria-hidden="true">✓</span><b>链接已复制</b>';shareButton.setAttribute('aria-label','文章链接已复制');if(shareStatus)shareStatus.textContent='文章链接已复制';window.setTimeout(resetShare,1800);};
    const copyLink=async()=>{await navigator.clipboard.writeText(location.href);copied();};
    shareButton?.addEventListener('click',async()=>{
      try{
        if(navigator.share){
          await navigator.share({title:document.title,text:document.querySelector('meta[name="description"]')?.getAttribute('content')||'',url:location.href});
          if(shareStatus)shareStatus.textContent='已打开系统分享';
        }else await copyLink();
      }catch(error){
        if((error as DOMException)?.name==='AbortError')return;
        try{await copyLink();}catch{if(shareButton){shareButton.innerHTML='<span aria-hidden="true">!</span><b>复制失败</b>';shareButton.setAttribute('aria-label','复制文章链接失败');}if(shareStatus)shareStatus.textContent='复制文章链接失败';}
      }
    });
  </script>
</BaseLayout>
