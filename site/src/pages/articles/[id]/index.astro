---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryLabels, categoryWords, estimateRead, formatDate, postSlug, sortPosts } from '../../../lib/posts';

export async function getStaticPaths(){
  const posts=sortPosts(await getCollection('posts'));
  return posts.map(post=>({params:{id:postSlug(post)},props:{post,posts}}));
}

const { post, posts }=Astro.props as { post:CollectionEntry<'posts'>; posts:CollectionEntry<'posts'>[] };
const { Content }=await render(post);
const others=posts
  .filter(item=>postSlug(item)!==postSlug(post))
  .sort((a,b)=>Number(b.data.category===post.data.category)-Number(a.data.category===post.data.category))
  .slice(0,3);
const contentLabel=post.data.contentType==='game'?'小游戏':categoryLabels[post.data.category];
---
<BaseLayout title={`${post.data.title} · rain`} description={post.data.excerpt} active="articles" bodyClass="article-page article-v2">
  <main>
    <article class="article-wrap">
      <div class="article-heading">
        <a class="back-crumb" href="/articles/">文章归档 / ARCHIVE</a>
        <div class="article-meta">
          <span data-pagefind-meta="date">{formatDate(post.data.date)}</span>
          <span>{post.data.contentType==='game'?'WEB GAME':estimateRead(post.body||'')}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="article-deck">{post.data.excerpt}</p>
        <div class="article-byline">
          <img class="avatar" src="https://github.com/rain-lei.png?size=160" alt="rain 的 GitHub 头像" />
          <span>rain<br /><small>student developer · remote</small></span>
        </div>
      </div>

      <div class={`article-hero ${post.data.accent}`}>
        <span class="visual-grid"></span>
        <span class="visual-label" data-pagefind-meta="category">{contentLabel}</span>
        <span class="visual-word">{post.data.contentType==='game'?'GAME':categoryWords[post.data.category]}</span>
        <span class="visual-shape"></span>
        <span class="visual-index">RAIN / {post.data.contentType==='game'?'PLAY':'ARTICLE'}<br />{formatDate(post.data.date)}</span>
      </div>

      {post.data.contentType==='game'&&post.data.playUrl&&
        <section class="game-stage" data-pagefind-ignore>
          <div class="game-stage-head">
            <div><p class="v2-kicker">PLAYGROUND / 在线试玩</p><h2>在这里直接玩</h2></div>
            <div class="game-actions">
              <a href={post.data.playUrl} target="_blank" rel="noopener noreferrer">全屏打开 ↗</a>
              {post.data.repository&&<a href={post.data.repository} target="_blank" rel="noopener noreferrer">查看源码 ↗</a>}
            </div>
          </div>
          <div class="game-frame"><iframe src={post.data.playUrl} title={`${post.data.title} 在线试玩`} loading="lazy" sandbox="allow-scripts allow-same-origin"></iframe></div>
          <div class="game-tech">{post.data.tech.map((item:string)=><span>{item}</span>)}</div>
        </section>
      }

      <div class="article-layout">
        <aside class="article-rail" data-pagefind-ignore>
          <div class="article-share"><span>SHARE</span><button id="copyLink" aria-label="复制文章链接">↗</button></div>
          <nav class="article-toc" id="articleToc" aria-label="本文目录" hidden><span>ON THIS PAGE</span><div id="articleTocLinks"></div></nav>
        </aside>
        <div class="article-body markdown-body" data-pagefind-body>
          <Content />
          <div class="article-end"><span>✳</span><p>{post.data.contentType==='game'?'小游戏加载失败时，可以使用上方“全屏打开”。':'感谢你读到这里。愿你今天也有一点属于自己的留白。'}</p></div>
          <div class="article-tags">
            <span>标签</span>
            <a href="/articles/">{contentLabel}</a>
            {post.data.tech.slice(0,2).map((item:string)=><a href={`/search/?q=${encodeURIComponent(item)}`}>{item}</a>)}
          </div>
        </div>
      </div>
    </article>

    <section class="next-reads">
      <div class="section-heading">
        <div><p class="eyebrow">继续阅读 / KEEP READING</p><h2>也许你会喜欢</h2></div>
        <a class="text-link" href="/articles/">全部文章 <span>↗</span></a>
      </div>
      <div class="mini-posts">{others.map((item,index)=><a class="mini-post" href={`/articles/${postSlug(item)}/`}><span class="mini-no">{String(index+1).padStart(2,'0')}</span><div><small>{item.data.contentType==='game'?'小游戏':categoryLabels[item.data.category]} · {formatDate(item.data.date)}</small><strong>{item.data.title}</strong></div><span>↗</span></a>)}</div>
    </section>
  </main>
  <script>document.getElementById('copyLink')?.addEventListener('click',async(event)=>{const button=event.currentTarget as HTMLButtonElement;try{await navigator.clipboard.writeText(location.href);button.textContent='✓';button.setAttribute('aria-label','文章链接已复制');window.setTimeout(()=>{button.textContent='↗';button.setAttribute('aria-label','复制文章链接');},1600);}catch{button.textContent='!';button.setAttribute('aria-label','复制失败');}});</script>
</BaseLayout>
